        "plan": {
          "claim_observed": "The baseline probe reads and executes the real /source/sample.py and calls checkout_total(250, -3); the call returns -750 instead of raising ValueError, so claim_present is true: checkout_total performs no negative-quantity validation and violates the README contract (E_CONTRACT) requiring ValueError for negative quantity, matching sample.py lines 4-5 (E_SAMPLE). The counterexample applies the identical probe to the same source text with only the contract guard inserted before the multiplication; there checkout_total(250, -3) raises ValueError and claim_present is false, showing the probe detects the missing validation rather than always reporting the defect.",
          "files": [
            {
              "bytes": 1383,
              "path": "generated/probe_common.py",
              "sha256": "5fb3292d2b2341c2274ed8d8f58bda1d71df0a6b1532224379cf0fcb8de97a65",
              "utf8": "\"\"\"Shared probe helpers for the checkout_total negative-quantity contract.\n\nThe contract (README.md) states: checkout_total must reject negative quantity\nwith ValueError. The probe therefore calls checkout_total with a negative\nquantity and reports whether the omission (no validation) is observable.\n\"\"\"\n\nimport types\n\nSOURCE_PATH = \"/source/sample.py\"\n\n\ndef read_source(path=SOURCE_PATH):\n    with open(path, \"r\", encoding=\"utf-8\") as handle:\n        return handle.read()\n\n\ndef load_module(name, source_text):\n    module = types.ModuleType(name)\n    module.__dict__[\"__file__\"] = name\n    exec(compile(source_text, name, \"exec\"), module.__dict__)\n    return module\n\n\ndef evaluate(module):\n    \"\"\"Return (claim_present, detail).\n\n    claim_present is True when checkout_total accepts a negative quantity and\n    returns a product instead of raising ValueError.\n    \"\"\"\n    fn = getattr(module, \"checkout_total\", None)\n    if fn is None:\n        return False, {\"outcome\": \"missing_function\"}\n    try:\n        value = fn(250, -3)\n    except ValueError as exc:\n        return False, {\"outcome\": \"raised_ValueError\", \"message\": str(exc)}\n    except Exception as exc:\n        return False, {\n            \"outcome\": \"raised_other\",\n            \"exception_type\": type(exc).__name__,\n            \"message\": str(exc),\n        }\n    return True, {\"outcome\": \"returned_value\", \"value\": value}\n"
            },
            {
              "bytes": 915,
              "path": "generated/baseline_probe.py",
              "sha256": "5984dc11a999b5cf6b2f8607fd5c60b01139edf9747283aa9881d5c438f21e83",
              "utf8": "\"\"\"Baseline: exercise the unmodified source at /source/sample.py.\n\nExpectation: checkout_total(250, -3) returns -750 rather than raising\nValueError, so the omission claim is present.\n\"\"\"\n\nimport json\nimport os\nimport sys\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n\nimport probe_common\n\n\ndef main():\n    source_text = probe_common.read_source()\n    module = probe_common.load_module(\"sample_under_test\", source_text)\n    claim_present, detail = probe_common.evaluate(module)\n    report = {\n        \"run\": \"baseline\",\n        \"source_path\": probe_common.SOURCE_PATH,\n        \"source_bytes\": len(source_text.encode(\"utf-8\")),\n        \"variant\": \"unmodified_source\",\n        \"probe\": \"checkout_total(250, -3)\",\n        \"detail\": detail,\n        \"claim_present\": bool(claim_present),\n    }\n    print(json.dumps(report, sort_keys=True))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"
            },
            {
              "bytes": 1530,
              "path": "generated/counterexample_probe.py",
              "sha256": "43f1ad3b320dc8baf266e5544300942e6cde24d322a3bc01e908aa4d5005029e",
              "utf8": "\"\"\"Counterexample: same probe against a contract-compliant variant.\n\nThe variant is derived from the real /source/sample.py text by inserting the\nnegative-quantity guard the contract requires. If the identical probe reports\nclaim_present False here, the probe discriminates between a validating and a\nnon-validating checkout_total, and is not merely always-True.\n\"\"\"\n\nimport json\nimport os\nimport sys\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n\nimport probe_common\n\nTARGET = \"def checkout_total(price, quantity):\\n    return price * quantity\"\nPATCHED = (\n    \"def checkout_total(price, quantity):\\n\"\n    \"    if quantity < 0:\\n\"\n    \"        raise ValueError('quantity must not be negative')\\n\"\n    \"    return price * quantity\"\n)\n\n\ndef main():\n    source_text = probe_common.read_source()\n    patched_text = source_text.replace(TARGET, PATCHED, 1)\n    patch_applied = patched_text != source_text\n    module = probe_common.load_module(\"sample_patched\", patched_text)\n    claim_present, detail = probe_common.evaluate(module)\n    report = {\n        \"run\": \"counterexample\",\n        \"source_path\": probe_common.SOURCE_PATH,\n        \"source_bytes\": len(source_text.encode(\"utf-8\")),\n        \"variant\": \"source_with_contract_guard_inserted\",\n        \"patch_applied\": patch_applied,\n        \"probe\": \"checkout_total(250, -3)\",\n        \"detail\": detail,\n        \"claim_present\": bool(claim_present),\n    }\n    print(json.dumps(report, sort_keys=True))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"
            }
          ],
