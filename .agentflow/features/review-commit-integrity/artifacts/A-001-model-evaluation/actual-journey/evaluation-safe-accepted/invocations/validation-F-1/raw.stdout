\": SRC,\n        \"probes\": {\n            \"can_read('mallory','alice',public=False)\": non_owner_private,\n            \"can_read('alice','alice',public=False)\": owner_private,\n            \"can_read('','alice',public=False)\": anonymous_private,\n            \"can_read('mallory','alice',public=True)\": anyone_public,\n        },\n        \"detail\": (\n            \"claim_present is true only if a non-owner authenticated requester \"\n            \"can read a private document\"\n        ),\n    }\n    json.dump(out, sys.stdout)\n    sys.stdout.write(\"\\n\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"},{"path":"generated/probe_mutated_positive_control.py","utf8":"import json\nimport sys\nimport types\n\nSRC = \"/source/sample.py\"\n\nORIGINAL_GUARD = \"requester == owner\"\nBYPASSED_GUARD = \"requester is not None\"\n\n\ndef main():\n    with open(SRC, \"r\", encoding=\"utf-8\") as fh:\n        source_text = fh.read()\n\n    guard_found = ORIGINAL_GUARD in source_text\n    mutated_text = source_text.replace(ORIGINAL_GUARD, BYPASSED_GUARD, 1)\n    mutation_applied = guard_found and mutated_text != source_text\n\n    mod = types.ModuleType(\"sample_bypassed_variant\")\n    mod.__file__ = SRC\n    exec(compile(mutated_text, \"<sample_bypassed_variant>\", \"exec\"), mod.__dict__)\n    can_read = mod.__dict__[\"can_read\"]\n\n    # Same probe as the baseline control, run against the bypassed variant.\n    non_owner_private = bool(can_read(\"mallory\", \"alice\", False))\n    owner_private = bool(can_read(\"alice\", \"alice\", False))\n\n    claim_present = bool(mutation_applied and non_owner_private)\n\n    out = {\n        \"claim_present\": claim_present,\n        \"control\": \"positive_control_mutated_ownership_check\",\n        \"source_path\": SRC,\n        \"mutation\": {\n            \"applied\": mutation_applied,\n            \"from\": ORIGINAL_GUARD,\n            \"to\": BYPASSED_GUARD,\n        },\n        \"probes\": {\n            \"can_read('mallory','alice',public=False)\": non_owner_private,\n            \"can_read('alice','alice',public=False)\": owner_private,\n        },\n        \"detail\": (\n            \"demonstrates the probe reports claim_present=true when the \"\n            \"ownership equality check is genuinely absent\"\n        ),\n    }\n    json.dump(out, sys.stdout)\n    sys.stdout.write(\"\\n\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"runs":[{"name":"baseline","argv":["python3","generated/probe_baseline.py"],"cwd":"/work","evidence_ids":["E_SAMPLE","E_CONTRACT"],"expect":{"exit":0,"observation":{"claim_present":false}}},{"name":"counterexample","argv":["python3","generated/probe_mutated_positive_control.py"],"cwd":"/work","evidence_ids":["E_SAMPLE","E_CONTRACT"],"expect":{"exit":0,"observation":{"claim_present":true}}}]},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3337,"cache_read_input_tokens":4547,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3337},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3294464e-73b8-4e93-8053-88ccb2542aab","uuid":"eb430790-cbe2-4ded-9d21-b2c31a912d77","timestamp":"2026-09-09T17:30:47.987Z","request_id":"req_011CetGC6KdQVNoqWJPphWM5"},{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G1VdwAYpGNbbexm3M5nDn4","type":"tool_result","content":"Structured output provided successfully"}]},"parent_tool_use_id":null,"session_id":"3294464e-73b8-4e93-8053-88ccb2542aab","uuid":"48c19ed8-b98f-4e26-b739-aad83bef5c50","timestamp":"2026-09-09T17:30:48.011Z","tool_use_result":"Structured output provided successfully"},{"duration_api_ms":56644,"stop_reason":"tool_use","session_id":"3294464e-73b8-4e93-8053-88ccb2542aab","total_cost_usd"