# Build only the standalone wheel from the four approved Python modules.
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS package-build
WORKDIR /build
COPY packaging/evaluation/build-requirements.lock ./build-requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: \
    --requirement build-requirements.lock
COPY pyproject.toml MANIFEST.in LICENSE ./
COPY scripts/review_model_evaluation.py scripts/review_model_adapters.py scripts/review_model_oci_executor.py scripts/review_round_weekly_report.py ./scripts/
RUN python -m pip wheel --no-cache-dir --no-build-isolation --no-deps --wheel-dir /wheelhouse .

# Install the exact Claude CLI release in a separate stage so the final image
# receives only its installed runtime, not npm's build cache.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS claude-cli
RUN npm install --global --no-audit --no-fund --omit=dev @anthropic-ai/claude-code@2.1.266 \
    && npm cache clean --force

FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      python3 \
      python3-venv \
      git \
      docker.io \
      ca-certificates \
      tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=claude-cli /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=claude-cli /usr/local/bin/claude /usr/local/bin/claude
COPY --from=package-build /wheelhouse/ /tmp/ocp-review-eval-wheelhouse/

RUN python3 -m venv /opt/ocp-review-eval/venv \
    && EVALUATION_WHEEL="$(find /tmp/ocp-review-eval-wheelhouse -maxdepth 1 -type f -name 'ocp_review_eval-*.whl' -print -quit)" \
    && test -n "$EVALUATION_WHEEL" \
    && /opt/ocp-review-eval/venv/bin/python -m pip install \
      --no-cache-dir --no-index --no-deps "$EVALUATION_WHEEL" \
    && rm -rf /tmp/ocp-review-eval-wheelhouse \
    && groupadd --system --gid 65532 evaluator \
    && useradd --system --uid 65532 --gid evaluator \
      --home-dir /home/evaluator --create-home --shell /usr/sbin/nologin evaluator \
    && install -d -o root -g root -m 1777 /tmp/ocp-review-eval-home \
    && install -d -o evaluator -g evaluator -m 0755 /work

ENV PATH="/opt/ocp-review-eval/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE="1"
WORKDIR /work
USER evaluator
ENTRYPOINT ["ocp-review-eval"]
CMD ["run"]
